<Window x:Class="Maktab.App.Wpf.Views.FirstRunAdminSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="راه‌اندازی مدیر سیستم"
        Width="560"
        Height="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Language="fa-IR"
        FlowDirection="RightToLeft"
        Background="#0F172A">
    <Grid>
        <Border Background="White"
                CornerRadius="12"
                Margin="30"
                Padding="30"
                BorderBrush="#E2E8F0"
                BorderThickness="1">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="راه‌اندازی اولیه سیستم"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="#0F172A"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,10" />

                <TextBlock Text="برای شروع، حساب مدیر اصلی مکتب را ایجاد کنید."
                           FontSize="14"
                           Foreground="#64748B"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,0,0,25" />

                <TextBlock Text="نام کامل:"
                           FontWeight="SemiBold"
                           Foreground="#334155"
                           Margin="0,0,0,6" />
                <TextBox x:Name="FullNameTextBox"
                         Height="40"
                         FontSize="14"
                         Padding="10,8"
                         Margin="0,0,0,14"
                         TextAlignment="Right" />

                <TextBlock Text="نام کاربری:"
                           FontWeight="SemiBold"
                           Foreground="#334155"
                           Margin="0,0,0,6" />
                <TextBox x:Name="UsernameTextBox"
                         Height="40"
                         FontSize="14"
                         Padding="10,8"
                         Margin="0,0,0,14"
                         TextAlignment="Right" />

                <TextBlock Text="رمز عبور:"
                           FontWeight="SemiBold"
                           Foreground="#334155"
                           Margin="0,0,0,6" />
                <PasswordBox x:Name="PasswordBox"
                             Height="40"
                             FontSize="14"
                             Padding="10,8"
                             Margin="0,0,0,14"
                             PasswordChar="●" />

                <TextBlock Text="تکرار رمز عبور:"
                           FontWeight="SemiBold"
                           Foreground="#334155"
                           Margin="0,0,0,6" />
                <PasswordBox x:Name="ConfirmPasswordBox"
                             Height="40"
                             FontSize="14"
                             Padding="10,8"
                             Margin="0,0,0,18"
                             PasswordChar="●" />

                <Button x:Name="CreateButton"
                        Content="ایجاد حساب مدیر"
                        Height="44"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Background="#1E3A8A"
                        Foreground="White"
                        FontSize="15"
                        FontWeight="Bold"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="CreateButton_Click" />

                <TextBlock x:Name="StatusTextBlock"
                           Foreground="#DC2626"
                           FontSize="13"
                           Margin="0,12,0,0"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
