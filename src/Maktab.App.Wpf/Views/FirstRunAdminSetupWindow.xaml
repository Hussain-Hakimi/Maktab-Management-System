<Window x:Class="Maktab.App.Wpf.Views.FirstRunAdminSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="راه‌اندازی مدیر سیستم"
        Width="620"
        Height="700"
        MinWidth="560"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Language="fa-IR"
        FlowDirection="RightToLeft"
        Background="#0F172A">
    <Grid>
        <Border Background="White"
                CornerRadius="12"
                Margin="24"
                Padding="32"
                BorderBrush="#E2E8F0"
                BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="راه‌اندازی اولیه سیستم"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="#0F172A"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,0,0,12" />

                    <TextBlock Text="برای شروع، حساب مدیر اصلی مکتب را ایجاد کنید."
                               FontSize="15"
                               Foreground="#64748B"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Margin="0,0,0,28" />

                    <TextBlock Text="نام کامل:"
                               FontWeight="SemiBold"
                               Foreground="#334155"
                               Margin="0,0,0,6" />
                    <TextBox x:Name="FullNameTextBox"
                             MinHeight="42"
                             FontSize="15"
                             Padding="10,8"
                             Margin="0,0,0,16"
                             TextAlignment="Right" />

                    <TextBlock Text="نام کاربری:"
                               FontWeight="SemiBold"
                               Foreground="#334155"
                               Margin="0,0,0,6" />
                    <TextBox x:Name="UsernameTextBox"
                             MinHeight="42"
                             FontSize="15"
                             Padding="10,8"
                             Margin="0,0,0,16"
                             TextAlignment="Right" />

                    <TextBlock Text="رمز عبور:"
                               FontWeight="SemiBold"
                               Foreground="#334155"
                               Margin="0,0,0,6" />
                    <PasswordBox x:Name="PasswordBox"
                                 MinHeight="42"
                                 FontSize="15"
                                 Padding="10,8"
                                 Margin="0,0,0,16"
                                 PasswordChar="●" />

                    <TextBlock Text="تکرار رمز عبور:"
                               FontWeight="SemiBold"
                               Foreground="#334155"
                               Margin="0,0,0,6" />
                    <PasswordBox x:Name="ConfirmPasswordBox"
                                 MinHeight="42"
                                 FontSize="15"
                                 Padding="10,8"
                                 Margin="0,0,0,22"
                                 PasswordChar="●" />

                    <Button x:Name="CreateButton"
                            Content="ایجاد حساب مدیر"
                            MinHeight="50"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Background="#1E3A8A"
                            Foreground="White"
                            FontSize="16"
                            FontWeight="Bold"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="CreateButton_Click" />

                    <TextBlock x:Name="StatusTextBlock"
                               Foreground="#DC2626"
                               FontSize="14"
                               Margin="0,14,0,0"
                               TextWrapping="Wrap"
                               TextAlignment="Right" />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
