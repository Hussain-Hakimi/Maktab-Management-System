<UserControl x:Class="Maktab.App.Wpf.Views.TextbookView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Maktab.App.Wpf.Views"
             mc:Ignorable="d"
             d:DesignHeight="650" d:DesignWidth="1000"
             FlowDirection="RightToLeft">
    <UserControl.Resources>
        <local:TextbookReturnEnabledConverter x:Key="TextbookReturnEnabledConverter" />
    </UserControl.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#B45309" Padding="14" CornerRadius="6" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="📦 مدیریت کتاب‌های درسی" FontSize="20" FontWeight="Bold" Foreground="White" />
                <TextBlock Text=" (Textbook Management)" FontSize="13" Foreground="#FDE68A" VerticalAlignment="Center" Margin="10,2,0,0" />
            </StackPanel>
        </Border>

        <TabControl Grid.Row="1" BorderThickness="0" Background="Transparent">
            <TabItem Header="📖 کتاب‌های درسی">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Textbook Form -->
                    <Border Grid.Column="0" Background="#FAFAFA" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="14">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="مشخصات کتاب درسی" FontSize="16" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,12" />

                                <TextBlock Text="عنوان (Title) *" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <TextBox x:Name="TextbookTitleTextBox" Height="32" Margin="0,0,0,10" MaxLength="100" />

                                <TextBlock Text="مضمون (Subject) *" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <ComboBox x:Name="SubjectNameComboBox"
                                          Height="32"
                                          Margin="0,0,0,10"
                                          DisplayMemberPath="SubjectName"
                                          SelectedValuePath="SubjectName" />

                                <TextBlock Text="صنف (Class) - اختیاری" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <ComboBox x:Name="TextbookClassComboBox" Height="32" Margin="0,0,0,10" DisplayMemberPath="GradeName" SelectedValuePath="ClassId" />

                                <TextBlock Text="تعداد کل نسخه‌ها (Total Copies) *" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <TextBox x:Name="TextbookTotalCopiesTextBox" Height="32" Margin="0,0,0,16" MaxLength="5" />

                                <UniformGrid Columns="2" Rows="2">
                                    <Button Margin="0,0,4,8" Height="36" Content="➕ افزودن" Background="#16A34A" Foreground="White" FontWeight="Bold" Click="AddTextbookButton_Click" />
                                    <Button Margin="4,0,0,8" Height="36" Content="✏️ ویرایش" Background="#D97706" Foreground="White" FontWeight="Bold" Click="UpdateTextbookButton_Click" />
                                    <Button Margin="0,4,4,0" Height="36" Content="🗑️ حذف" Background="#DC2626" Foreground="White" FontWeight="Bold" Click="DeleteTextbookButton_Click" />
                                    <Button Margin="4,4,0,0" Height="36" Content="🧹 پاک کردن" Background="#64748B" Foreground="White" FontWeight="SemiBold" Click="ClearTextbookFormButton_Click" />
                                </UniformGrid>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- Textbooks DataGrid -->
                    <Border Grid.Column="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="لیست کتاب‌های درسی" FontWeight="Bold" FontSize="15" Foreground="#334155" Margin="4,4,4,8" />
                            <DataGrid x:Name="TextbooksDataGrid"
                                      Grid.Row="1"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      IsReadOnly="True"
                                      SelectionMode="Single"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="#E2E8F0"
                                      SelectionChanged="TextbooksDataGrid_SelectionChanged"
                                      RowHeight="32">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="آیدی" Binding="{Binding TextbookId}" Width="60" />
                                    <DataGridTextColumn Header="عنوان" Binding="{Binding Title}" Width="*" />
                                    <DataGridTextColumn Header="مضمون" Binding="{Binding Subject}" Width="100" />
                                    <DataGridTextColumn Header="صنف" Binding="{Binding ClassName}" Width="100" />
                                    <DataGridTextColumn Header="کل نسخه‌ها" Binding="{Binding TotalCopies}" Width="90" />
                                    <DataGridTextColumn Header="موجود" Binding="{Binding AvailableCopies}" Width="70" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Issue/Return Tab -->
            <TabItem Header="📤 امانت‌دهی و بازگشت">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" Padding="10" CornerRadius="6" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="کتاب درسی:" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,6,0" />
                            <ComboBox x:Name="IssueTextbookComboBox" Grid.Column="1" Height="32" DisplayMemberPath="Title" SelectedValuePath="TextbookId" />

                            <TextBlock Grid.Column="3" Text="شاگرد:" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,6,0" />
                            <ComboBox x:Name="IssueStudentComboBox" Grid.Column="4" Height="32" DisplayMemberPath="DisplayName" SelectedValuePath="StudentId" />

                            <Button Grid.Column="7" Content="📤 ثبت امانت" Height="32" Padding="16,0" Background="#16A34A" Foreground="White" FontWeight="Bold" Click="IssueTextbookButton_Click" />
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="امانت‌های فعال" FontWeight="Bold" FontSize="15" Foreground="#334155" />
                                <Button Grid.Column="1" Content="🔄 تازه‌سازی" Height="28" Padding="10,0" Background="#3B82F6" Foreground="White" FontWeight="SemiBold" Click="RefreshIssuesButton_Click" />
                            </Grid>

                            <DataGrid x:Name="IssuesDataGrid"
                                      Grid.Row="1"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      IsReadOnly="True"
                                      SelectionMode="Single"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="#E2E8F0"
                                      RowHeight="32">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Issue ID" Binding="{Binding IssueId}" Width="70" />
                                    <DataGridTextColumn Header="کتاب" Binding="{Binding TextbookTitle}" Width="*" />
                                    <DataGridTextColumn Header="شاگرد" Binding="{Binding StudentName}" Width="*" />
                                    <DataGridTextColumn Header="اساس" Binding="{Binding RollNumber}" Width="70" />
                                    <DataGridTextColumn Header="تاریخ امانت" Binding="{Binding IssueDate, StringFormat={}{0:yyyy/MM/dd}}" Width="90" />
                                    <DataGridTextColumn Header="برگشت" Binding="{Binding ReturnDate, StringFormat={}{0:yyyy/MM/dd}}" Width="90" />
                                    <DataGridTextColumn Header="وضعیت" Binding="{Binding Status}" Width="70" />
                                    <DataGridTemplateColumn Header="عملیات" Width="100">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="بازگشت" Background="#2563EB" Foreground="White" FontSize="12" Padding="8,4"
                                                        Click="ReturnTextbookButton_Click"
                                                        IsEnabled="{Binding Status, Converter={StaticResource TextbookReturnEnabledConverter}}"
                                                        Tag="{Binding IssueId}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
