                            </WrapPanel>
                            <Border Grid.Row="2" Background="#F0FDF4" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,0,0,8">
                                <TextBlock FontSize="12" Foreground="#166534">
                                    <Run FontWeight="Bold">&#x641;&#x627;&#x631;&#x645;&#x62A;: </Run><Run FontFamily="Consolas">RollNumber | Date (YYYY-MM-DD) | Status (Present/Absent/Late)</Run>
                                </TextBlock>
                            </Border>
                            <TextBox x:Name="AttendanceCsvTextBox" Grid.Row="3" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" Padding="8" Background="#F8FAFC" BorderBrush="#CBD5E1" />
                        </Grid>
                    </Border>
                    <Border Grid.Column="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12">
                        <StackPanel>
                            <TextBlock Text="&#x646;&#x62A;&#x627;&#x6CC;&#x62C;" FontWeight="Bold" FontSize="15" Foreground="#334155" Margin="0,0,0,12" />
                            <TextBlock x:Name="AttendanceSummaryTextBlock" Text="&#x6F0; &#x631;&#x62F;&#x6CC;&#x641; &#x648;&#x627;&#x631;&#x62F; &#x634;&#x62F;" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <TextBox x:Name="AttendanceErrorsTextBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Height="200" FontSize="11" Background="#FEF2F2" Foreground="#DC2626" />
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
