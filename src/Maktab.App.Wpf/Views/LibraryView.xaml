<UserControl x:Class="Maktab.App.Wpf.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="650" d:DesignWidth="1000"
             FlowDirection="RightToLeft">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#7C3AED" Padding="14" CornerRadius="6" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="📚 مدیریت کتابخانه" FontSize="20" FontWeight="Bold" Foreground="White" />
                <TextBlock Text=" (Library Management)" FontSize="13" Foreground="#DDD6FE" VerticalAlignment="Center" Margin="10,2,0,0" />
            </StackPanel>
        </Border>

        <!-- Main Tabs -->
        <TabControl Grid.Row="1" BorderThickness="0" Background="Transparent">
            <!-- Books Tab -->
            <TabItem Header="📖 کتاب‌ها">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Book Form -->
                    <Border Grid.Column="0" Background="#FAFAFA" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="14">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="مشخصات کتاب" FontSize="16" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,12" />

                                <TextBlock Text="عنوان (Title) *" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <TextBox x:Name="BookTitleTextBox" Height="32" Margin="0,0,0,10" MaxLength="100" />

                                <TextBlock Text="نویسنده (Author) *" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <TextBox x:Name="BookAuthorTextBox" Height="32" Margin="0,0,0,10" MaxLength="100" />

                                <TextBlock Text="شابک (ISBN)" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <TextBox x:Name="BookISBNTextBox" Height="32" Margin="0,0,0,10" MaxLength="30" />

                                <TextBlock Text="کتگوری (Category)" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <TextBox x:Name="BookCategoryTextBox" Height="32" Margin="0,0,0,10" MaxLength="50" />

                                <TextBlock Text="تعداد کل نسخه‌ها (Total Copies) *" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <TextBox x:Name="BookTotalCopiesTextBox" Height="32" Margin="0,0,0,16" MaxLength="5" />

                                <UniformGrid Columns="2" Rows="2">
                                    <Button Margin="0,0,4,8" Height="36" Content="➕ افزودن" Background="#16A34A" Foreground="White" FontWeight="Bold" Click="AddBookButton_Click" />
                                    <Button Margin="4,0,0,8" Height="36" Content="✏️ ویرایش" Background="#D97706" Foreground="White" FontWeight="Bold" Click="UpdateBookButton_Click" />
                                    <Button Margin="0,4,4,0" Height="36" Content="🗑️ حذف" Background="#DC2626" Foreground="White" FontWeight="Bold" Click="DeleteBookButton_Click" />
                                    <Button Margin="4,4,0,0" Height="36" Content="🧹 پاک کردن" Background="#64748B" Foreground="White" FontWeight="SemiBold" Click="ClearBookFormButton_Click" />
                                </UniformGrid>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- Books DataGrid -->
                    <Border Grid.Column="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="لیست کتاب‌ها" FontWeight="Bold" FontSize="15" Foreground="#334155" Margin="4,4,4,8" />
                            <DataGrid x:Name="BooksDataGrid"
                                      Grid.Row="1"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      IsReadOnly="True"
                                      SelectionMode="Single"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="#E2E8F0"
                                      SelectionChanged="BooksDataGrid_SelectionChanged"
                                      RowHeight="32">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="آیدی" Binding="{Binding BookId}" Width="60" />
                                    <DataGridTextColumn Header="عنوان" Binding="{Binding Title}" Width="*" />
                                    <DataGridTextColumn Header="نویسنده" Binding="{Binding Author}" Width="*" />
                                    <DataGridTextColumn Header="شابک" Binding="{Binding ISBN}" Width="100" />
                                    <DataGridTextColumn Header="کتگوری" Binding="{Binding Category}" Width="100" />
                                    <DataGridTextColumn Header="کل نسخه‌ها" Binding="{Binding TotalCopies}" Width="90" />
                                    <DataGridTextColumn Header="موجود" Binding="{Binding AvailableCopies}" Width="70" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Issue/Return Tab -->
            <TabItem Header="📤 امانت‌دهی و بازگشت">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Issue Form -->
                    <Border Grid.Row="0" Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" Padding="10" CornerRadius="6" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="کتاب:" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,6,0" />
                            <ComboBox x:Name="IssueBookComboBox" Grid.Column="1" Height="32" DisplayMemberPath="Title" SelectedValuePath="BookId" />

                            <TextBlock Grid.Column="3" Text="شاگرد:" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,6,0" />
                            <ComboBox x:Name="IssueStudentComboBox" Grid.Column="4" Height="32" DisplayMemberPath="DisplayName" SelectedValuePath="StudentId" />

                            <TextBlock Grid.Column="6" Text="تاریخ برگشت (Due Date):" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,6,0" />
                            <DatePicker x:Name="IssueDueDatePicker" Grid.Column="7" Height="32" />

                            <Button Grid.Column="9" Content="📤 ثبت امانت" Height="32" Padding="16,0" Background="#16A34A" Foreground="White" FontWeight="Bold" Click="IssueBookButton_Click" />
                        </Grid>
                    </Border>

                    <!-- Issues DataGrid -->
                    <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="امانت‌های فعال" FontWeight="Bold" FontSize="15" Foreground="#334155" />
                                <Button Grid.Column="1" Content="🔄 تازه‌سازی" Height="28" Padding="10,0" Background="#3B82F6" Foreground="White" FontWeight="SemiBold" Click="RefreshIssuesButton_Click" Margin="0,0,8,0" />
                                <Button Grid.Column="2" Content="⚠️ فقط عقب‌مانده‌ها" Height="28" Padding="10,0" Background="#DC2626" Foreground="White" FontWeight="SemiBold" Click="ShowOverdueButton_Click" />
                            </Grid>

                            <DataGrid x:Name="IssuesDataGrid"
                                      Grid.Row="1"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      IsReadOnly="True"
                                      SelectionMode="Single"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="#E2E8F0"
                                      RowHeight="32">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Issue ID" Binding="{Binding IssueId}" Width="70" />
                                    <DataGridTextColumn Header="کتاب" Binding="{Binding BookTitle}" Width="*" />
                                    <DataGridTextColumn Header="شاگرد" Binding="{Binding StudentName}" Width="*" />
                                    <DataGridTextColumn Header="اساس" Binding="{Binding RollNumber}" Width="70" />
                                    <DataGridTextColumn Header="تاریخ امانت" Binding="{Binding IssueDate, StringFormat={}{0:yyyy/MM/dd}}" Width="90" />
                                    <DataGridTextColumn Header="موعد برگشت" Binding="{Binding DueDate, StringFormat={}{0:yyyy/MM/dd}}" Width="90" />
                                    <DataGridTextColumn Header="برگشت" Binding="{Binding ReturnDate, StringFormat={}{0:yyyy/MM/dd}}" Width="90" />
                                    <DataGridTextColumn Header="وضعیت" Binding="{Binding Status}" Width="70" />
                                    <DataGridTemplateColumn Header="عملیات" Width="100">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="بازگشت" Background="#2563EB" Foreground="White" FontSize="12" Padding="8,4"
                                                        Click="ReturnBookButton_Click"
                                                        IsEnabled="{Binding Status, Converter={StaticResource BookReturnEnabledConverter}}"
                                                        Tag="{Binding IssueId}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
