<UserControl x:Class="Maktab.App.Wpf.Views.ClassSubjectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1000"
             FlowDirection="RightToLeft">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#1E40AF" Padding="14" CornerRadius="6" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="🏫 مدیریت صنف‌ها و مضامین" FontSize="20" FontWeight="Bold" Foreground="White" />
                <TextBlock Text=" (Class &amp; Subject Management)" FontSize="13" Foreground="#BFDBFE" VerticalAlignment="Center" Margin="10,2,0,0" />
            </StackPanel>
        </Border>

        <!-- Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Classes Panel -->
            <Border Grid.Column="0" Padding="12" Background="#FAFAFA" BorderThickness="1" BorderBrush="#E2E8F0" CornerRadius="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock FontSize="16" FontWeight="Bold" Text="📋 صنف‌ها (Classes)" Foreground="#1E3A5F" />

                    <StackPanel Grid.Row="1" Margin="0,10,0,12">
                        <TextBlock Text="نام صنف (Grade Name)" FontWeight="SemiBold" Foreground="#334155" />
                        <TextBox x:Name="GradeNameTextBox" Margin="0,4,0,10" Height="32" MaxLength="50" FontSize="14" Padding="6,4" />

                        <TextBlock Text="تعداد مضامین (Number of Subjects)" FontWeight="SemiBold" Foreground="#334155" />
                        <TextBox x:Name="NumberOfSubjectsTextBox" Margin="0,4,0,10" Height="32" MaxLength="3" FontSize="14" Padding="6,4" />

                        <UniformGrid Columns="4" Rows="1">
                            <Button Margin="0,0,6,0" Height="34" Content="➕ افزودن" Background="#059669" Foreground="White" FontWeight="Bold" Click="AddClassButton_Click" />
                            <Button Margin="0,0,6,0" Height="34" Content="✏️ ویرایش" Background="#2563EB" Foreground="White" FontWeight="Bold" Click="UpdateClassButton_Click" />
                            <Button Margin="0,0,6,0" Height="34" Content="🗑️ حذف" Background="#DC2626" Foreground="White" FontWeight="Bold" Click="DeleteClassButton_Click" />
                            <Button Height="34" Content="🔄 پاک‌سازی" Background="#6B7280" Foreground="White" FontWeight="SemiBold" Click="ClearClassButton_Click" />
                        </UniformGrid>
                    </StackPanel>

                    <DataGrid x:Name="ClassesDataGrid"
                              Grid.Row="2"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#E2E8F0"
                              RowHeight="32"
                              SelectionChanged="ClassesDataGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="شماره" Binding="{Binding ClassId}" Width="70" />
                            <DataGridTextColumn Header="نام صنف" Binding="{Binding GradeName}" Width="*" />
                            <DataGridTextColumn Header="تعداد مضامین" Binding="{Binding NumberOfSubjects}" Width="110" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Subjects Panel -->
            <Border Grid.Column="2" Padding="12" Background="#FAFAFA" BorderThickness="1" BorderBrush="#E2E8F0" CornerRadius="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock FontSize="16" FontWeight="Bold" Text="📚 مضامین (Subjects)" Foreground="#1E3A5F" />

                    <StackPanel Grid.Row="1" Margin="0,10,0,12">
                        <TextBlock Text="صنف انتخاب‌شده (Selected Class)" FontWeight="SemiBold" Foreground="#334155" />
                        <TextBlock x:Name="SelectedClassTextBlock"
                                   Margin="0,4,0,10"
                                   FontWeight="SemiBold"
                                   Foreground="#059669"
                                   Text="لطفاً یک صنف را از جدول سمت راست انتخاب کنید" />

                        <TextBlock Text="نام مضمون (Subject Name)" FontWeight="SemiBold" Foreground="#334155" />
                        <TextBox x:Name="SubjectNameTextBox" Margin="0,4,0,10" Height="32" MaxLength="80" FontSize="14" Padding="6,4" />

                        <UniformGrid Columns="4" Rows="1">
                            <Button Margin="0,0,6,0" Height="34" Content="➕ افزودن" Background="#059669" Foreground="White" FontWeight="Bold" Click="AddSubjectButton_Click" />
                            <Button Margin="0,0,6,0" Height="34" Content="✏️ ویرایش" Background="#2563EB" Foreground="White" FontWeight="Bold" Click="UpdateSubjectButton_Click" />
                            <Button Margin="0,0,6,0" Height="34" Content="🗑️ حذف" Background="#DC2626" Foreground="White" FontWeight="Bold" Click="DeleteSubjectButton_Click" />
                            <Button Height="34" Content="🔄 پاک‌سازی" Background="#6B7280" Foreground="White" FontWeight="SemiBold" Click="ClearSubjectButton_Click" />
                        </UniformGrid>
                    </StackPanel>

                    <DataGrid x:Name="SubjectsDataGrid"
                              Grid.Row="2"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#E2E8F0"
                              RowHeight="32"
                              SelectionChanged="SubjectsDataGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="شماره" Binding="{Binding SubjectId}" Width="70" />
                            <DataGridTextColumn Header="نام مضمون" Binding="{Binding SubjectName}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
