<Window x:Class="Maktab.App.Wpf.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="ورود به سیستم"
        Height="400" Width="480"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Language="fa-IR"
        FlowDirection="RightToLeft"
        Background="#F1F5F9">

    <Grid>
        <Border Background="White" CornerRadius="12" Margin="30" Padding="30"
                BorderBrush="#E2E8F0" BorderThickness="1">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="📘 سیستم مدیریت مکتب" FontSize="22" FontWeight="Bold"
                           HorizontalAlignment="Center" Margin="0,0,0,10" Foreground="#0F172A" />
                <TextBlock Text="لطفاً وارد شوید" FontSize="14" Foreground="#475569"
                           HorizontalAlignment="Center" Margin="0,0,0,30" />

                <TextBlock Text="نام کاربری" FontWeight="SemiBold" Margin="0,0,0,6" Foreground="#334155" />
                <TextBox x:Name="UsernameTextBox" Height="40" Margin="0,0,0,16"
                         FontSize="14" Padding="10,8" VerticalContentAlignment="Center"
                         TextAlignment="Right" />

                <TextBlock Text="رمز عبور" FontWeight="SemiBold" Margin="0,0,0,6" Foreground="#334155" />
                <PasswordBox x:Name="PasswordBox" Height="40" Margin="0,0,0,24"
                             FontSize="14" Padding="10,8" VerticalContentAlignment="Center" />

                <Button Height="44" Content="ورود" Background="#3B82F6" Foreground="White"
                        FontWeight="Bold" FontSize="16" BorderThickness="0"
                        Cursor="Hand" Click="LoginButton_Click" />

                <TextBlock x:Name="ErrorTextBlock" Foreground="#DC2626" FontSize="13"
                           Margin="0,14,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
