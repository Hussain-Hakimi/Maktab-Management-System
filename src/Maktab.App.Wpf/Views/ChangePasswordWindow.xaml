<Window x:Class="Maktab.App.Wpf.Views.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="تغییر رمز عبور"
        Height="380" Width="430"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Language="fa-IR"
        FlowDirection="RightToLeft"
        Background="#F1F5F9">
    <Grid>
        <Border Background="White" CornerRadius="12" Margin="30" Padding="30"
                BorderBrush="#E2E8F0" BorderThickness="1">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="🔒 تغییر رمز عبور" FontSize="20" FontWeight="Bold"
                           HorizontalAlignment="Center" Margin="0,0,0,20" Foreground="#0F172A" />

                <TextBlock Text="رمز عبور فعلی" FontWeight="SemiBold" Margin="0,0,0,6" Foreground="#334155" />
                <PasswordBox x:Name="OldPasswordBox" Height="40" Margin="0,0,0,16"
                             FontSize="14" Padding="10,8" VerticalContentAlignment="Center" />

                <TextBlock Text="رمز عبور جدید" FontWeight="SemiBold" Margin="0,0,0,6" Foreground="#334155" />
                <PasswordBox x:Name="NewPasswordBox" Height="40" Margin="0,0,0,16"
                             FontSize="14" Padding="10,8" VerticalContentAlignment="Center" />

                <TextBlock Text="تکرار رمز عبور جدید" FontWeight="SemiBold" Margin="0,0,0,6" Foreground="#334155" />
                <PasswordBox x:Name="ConfirmPasswordBox" Height="40" Margin="0,0,0,24"
                             FontSize="14" Padding="10,8" VerticalContentAlignment="Center" />

                <Button Height="44" Content="ذخیره رمز عبور" Background="#3B82F6" Foreground="White"
                        FontWeight="Bold" FontSize="15" BorderThickness="0" CornerRadius="6"
                        Cursor="Hand" Click="SaveButton_Click" />

                <TextBlock x:Name="ErrorTextBlock" Foreground="#DC2626" FontSize="13"
                           Margin="0,14,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
