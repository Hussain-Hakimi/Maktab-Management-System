<Window x:Class="Maktab.App.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="سیستم مدیریت مکتب - Afghan School Management System"
        Height="760"
        Width="1200"
        MinHeight="600"
        MinWidth="900"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Language="fa-IR"
        FlowDirection="RightToLeft">

    <Window.Resources>
        <Style x:Key="SidebarItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Foreground" Value="#CBD5E1" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="6">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#334155" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3B82F6" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top Header Bar -->
        <Border Grid.Row="0" Background="#0F172A" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📘" FontSize="24" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="سیستم مدیریت مکتب" FontSize="20" FontWeight="Bold" Foreground="White" />
                        <TextBlock Text="Afghan School Management System — V1.2.0" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0" FlowDirection="LeftToRight" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="CurrentUserTextBlock" Text="" FontSize="12" Foreground="#CBD5E1" VerticalAlignment="Center" Margin="0,0,16,0" />
                    <TextBlock x:Name="SchoolYearTextBlock" Text="" FontSize="12" Foreground="#CBD5E1" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <TextBlock x:Name="CurrentDateTextBlock" Text="" FontSize="12" Foreground="#CBD5E1" VerticalAlignment="Center" Margin="0,0,16,0" />
                    <Button Content="🔒 تغییر رمز عبور" Height="30" Padding="12,0" Background="#334155" Foreground="White"
                            FontSize="12" FontWeight="SemiBold" BorderThickness="0" CornerRadius="4" Cursor="Hand"
                            Click="ChangePasswordButton_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Area with Sidebar -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0" Background="#1E293B">
                <ListBox x:Name="SidebarListBox"
                         SelectionChanged="SidebarListBox_SelectionChanged"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="#CBD5E1"
                         FontSize="14"
                         ItemContainerStyle="{StaticResource SidebarItemStyle}">
                    <ListBoxItem Content="🏠 داشبورد" />
                    <ListBoxItem Content="👨‍🎓 شاگردان" />
                    <ListBoxItem Content="🏫 صنف‌ها و مضامین" />
                    <ListBoxItem Content="📝 ثبت نمرات" />
                    <ListBoxItem Content="🗓️ حاضری" />
                    <ListBoxItem Content="📚 کتابخانه" />
                    <ListBoxItem Content="📦 کتاب‌های درسی" />
                    <ListBoxItem Content="💰 فیس‌ها" />
                    <ListBoxItem Content="📄 کارنامه / اطلاع‌نامه" />
                    <ListBoxItem Content="💾 پشتیبان‌گیری و تنظیمات" />
                    <ListBoxItem Content="👥 مدیریت کاربران (Admin)" />
                    <ListBoxItem Content="⚙️ تنظیمات ارتقاء (Admin)" />
                    <ListBoxItem Content="📥 ورود اطلاعات دسته‌جمعی (Admin)" />
                    <ListBoxItem Content="📋 گزارش وقایع (Admin)" />
                    <ListBoxItem Content="🏫 تنظیمات عمومی (Admin)" />
                </ListBox>
            </Border>

            <!-- Content Area -->
            <ContentControl x:Name="MainContentArea" Grid.Column="1" />
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="#0F172A" Padding="12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusBarText" Text="آماده" FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="نسخه ۱.۲.۰ — ساخته‌شده با ❤️ برای مکاتب افغانستان" FontSize="11" Foreground="#64748B" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
